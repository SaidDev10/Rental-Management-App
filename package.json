{
  "name": "rental-management-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build:api": "tsx esbuild.config.ts api-handler",
    "build:authorizer": "tsx esbuild.config.ts authorizer",
    "build:pdf": "tsx esbuild.config.ts pdf-worker",
    "build:report": "tsx esbuild.config.ts report-worker",
    "build:notify": "tsx esbuild.config.ts notification-worker",
    "build:stream": "tsx esbuild.config.ts stream-aggregator",
    "build": "pnpm run build:api && pnpm run build:authorizer && pnpm run build:pdf && pnpm run build:report && pnpm run build:notify && pnpm run build:stream && tsx scripts/verify-bundle-size.ts",
    "seed": "tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/client-lambda": "^3.699.0",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/client-sesv2": "^3.699.0",
    "@aws-sdk/client-sqs": "^3.699.0",
    "@aws-sdk/client-ssm": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@eslint/js": "^9.17.0",
    "@hono/aws-lambda": "^1.0.0",
    "@hono/node-server": "^1.1.0",
    "@hono/zod-validator": "^0.7.0",
    "@node-rs/argon2": "^2.0.0",
    "@sparticuz/chromium": "^138.0.0",
    "aws-embedded-metrics": "^4.0.0",
    "dotenv": "^16.4.1",
    "eslint-plugin-import": "^2.31.0",
    "exceljs": "^4.1.1",
    "handlebars": "^4.0.0",
    "hono": "^4.13.0",
    "jose": "^6.0.0",
    "pino": "^9.0.0",
    "puppeteer-core": "^24.0.0",
    "twilio": "^5.0.0",
    "typescript-eslint": "^8.17.0",
    "ulid": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.10.2",
    "archiver": "^8.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
